---
import { site } from '../content';
import { url } from '../lib/utils';
const home = url('/').replace(/\/?$/, '/');
const h = (id: string) => `${home}#${id}`;
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="logo" href={url('/')} aria-label={`${site.name}, home`}>
      <span class="logo__full" aria-hidden="true">{site.name}<span class="logo__dot">.</span></span>
      <span class="logo__short" aria-hidden="true">Vorleak<span class="logo__dot">.</span></span>
    </a>
    <nav aria-label="Main">
      <ul>
        <li><a href={h('work')}>Work</a></li>
        <li><a href={h('about')}>About</a></li>
        <li><a href={url(site.resume)} target="_blank" rel="noopener">Resume<span class="visually-hidden"> (PDF, opens in a new tab)</span></a></li>
        <li><a class="nav-cta" href={h('contact')}>Contact <span aria-hidden="true">↗</span></a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(248, 246, 241, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(29, 43, 52, 0.12);
  }
  .site-header__inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 0.5rem; min-height: 4.25rem;
  }
  .logo {
    display: inline-flex; align-items: center; min-height: 44px;
    font-family: var(--font-display); font-size: 1.65rem; line-height: 1; letter-spacing: -0.015em;
    color: var(--ink); text-decoration: none; white-space: nowrap;
  }
  .logo:hover { color: var(--ink); }
  .logo__dot { color: var(--coral); display: inline-block; transition: transform 0.3s var(--ease); }
  .logo:hover .logo__dot { transform: translateY(-3px); }
  .logo__full { display: none; }
  @media (min-width: 600px) { .logo__full { display: inline; } .logo__short { display: none; } }

  nav ul { display: flex; align-items: center; gap: 0.1rem; list-style: none; margin: 0; padding: 0; }
  nav a {
    display: inline-flex; align-items: center; min-height: 44px;
    padding: 0 0.5rem;
    color: var(--muted); text-decoration: none; font-size: 0.9rem;
    transition: color 0.2s;
  }
  nav a:hover { color: var(--ink); }
  nav a.nav-cta {
    gap: 0.3rem; margin-left: 0.35rem; padding: 0 0.95rem; min-height: 40px;
    background: var(--ink); color: var(--bg); border-radius: 999px; font-weight: 600;
    transition: transform 0.25s var(--ease);
  }
  nav a.nav-cta:hover { color: var(--bg); transform: translateY(-2px); }
  @media (min-width: 768px) { nav ul { gap: 1.25rem; } }
  /* Small phones: tighten so the name + all four links fit */
  @media (max-width: 420px) {
    .logo { font-size: 1.4rem; }
    nav a { padding: 0 0.4rem; font-size: 0.85rem; }
    nav a.nav-cta { margin-left: 0.15rem; padding: 0 0.75rem; }
    .nav-cta span[aria-hidden] { display: none; }
  }
</style>

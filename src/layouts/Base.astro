---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../content';
import { url } from '../lib/utils';

interface Props { title?: string; description?: string; image?: string }
const { title, description = site.description, image = site.ogImage } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(image), Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f8f6f1" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />

    <!-- Open Graph / social previews -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${site.name}, portfolio`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400&family=Instrument+Serif:ital@0;1&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="before-header" />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <!-- Image viewer: click-to-enlarge images open here instead of a new tab -->
    <dialog class="lightbox" aria-label="Image viewer">
      <div class="lightbox__bar">
        <button type="button" class="lightbox__back" data-close>← Back</button>
      </div>
      <img class="lightbox__img" alt="" />
    </dialog>
    <script>
      const dlg = document.querySelector<HTMLDialogElement>('.lightbox');
      const img = dlg?.querySelector<HTMLImageElement>('.lightbox__img');
      if (dlg && img && typeof dlg.showModal === 'function') {
        document.addEventListener('click', (e) => {
          const link = (e.target as Element).closest<HTMLAnchorElement>('a.media__zoom');
          if (!link || e.metaKey || e.ctrlKey || e.shiftKey) return;
          e.preventDefault();
          const thumb = link.querySelector('img');
          img.src = link.href;
          img.alt = thumb?.alt ?? '';
          dlg.showModal();
        });
        dlg.querySelector('[data-close]')?.addEventListener('click', () => dlg.close());
        // Clicking the dark backdrop (outside the image) closes too; Esc is built in
        dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
        dlg.addEventListener('close', () => { img.removeAttribute('src'); });
      }
    </script>
  </body>
</html>

<style>
  main:focus { outline: none; }

  .lightbox {
    width: min(92vw, 1200px); max-height: 92vh;
    padding: 0; border: 0; border-radius: var(--r);
    background: var(--bg); color: var(--ink);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
  }
  .lightbox::backdrop { background: rgba(29, 43, 52, 0.75); }
  .lightbox[open] { display: flex; flex-direction: column; }
  .lightbox__bar {
    display: flex; justify-content: flex-start;
    padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--line);
  }
  .lightbox__back {
    min-height: 44px; padding: 0 1.1rem;
    border: 1px solid rgba(29, 43, 52, 0.22); border-radius: 999px;
    background: var(--ink); color: var(--bg);
    font: 600 0.92rem var(--font-body); cursor: pointer;
  }
  .lightbox__back:hover { background: var(--coral-deep); border-color: var(--coral-deep); }
  .lightbox__img { display: block; max-width: 100%; max-height: calc(92vh - 4rem); margin: 0 auto; object-fit: contain; padding: 1rem; }
</style>

---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import Media from '../components/Media.astro';
import Txt from '../components/Txt.astro';
import {
  site, hero, home, about, caseStudies, experience, skills, certifications, coursework, contact,
} from '../content';
import { url, isTodo, emph } from '../lib/utils';

const featuredStudies = caseStudies.filter((c) => (c.tier ?? 'featured') === 'featured');
const moreStudies = caseStudies.filter((c) => c.tier === 'more');
const researchRoles = experience.filter((e) => e.tier === 'research');
const otherRoles = experience.filter((e) => e.tier === 'other');
---
<Base>
  <!-- ============ INTRO + ABOUT (first thing visitors see) ============ -->
  <section id="about" class="intro paper-grid" aria-labelledby="intro-title">
    <div class="intro__glow" aria-hidden="true"></div>
    <div class="container intro__grid">
      <div class="intro__copy">
        <p class="eyebrow fade-up">{hero.greeting}</p>
        <h1 id="intro-title" class="highlight fade-up delay-1" set:html={emph(hero.headline)} />
        <ul class="intro__sub fade-up delay-1" aria-label="In brief">
          {hero.subhead.map((s) => <li>{s}</li>)}
        </ul>
        <div class="intro__about fade-up delay-2">
          {about.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <div class="intro__actions fade-up delay-3">
          <a class="btn btn--primary" href="#work">See my work <span class="arrow" aria-hidden="true">↓</span></a>
          <a class="btn" href={url(site.resume)} target="_blank" rel="noopener">
            Resume <span aria-hidden="true">↗</span><span class="visually-hidden"> (PDF, opens in a new tab)</span>
          </a>
        </div>
      </div>

      <figure class="portrait fade-up delay-2">
        <div class="portrait__frame">
          <Media {...about.headshot} ratio="4 / 5" eager />
        </div>
        <figcaption>{about.caption}</figcaption>
        <ul class="facts" aria-label="Quick facts">
          {about.facts.map((f, i) => (
            <li><span class="facts__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{f}</li>
          ))}
        </ul>
      </figure>
    </div>

    <!-- What I bring -->
    <div class="container strengths">
      <h2 id="strengths-title" class="eyebrow eyebrow--muted">{hero.strengthsHeading}</h2>
      <ol class="strengths__list" aria-labelledby="strengths-title">
        {hero.strengths.map((s, i) => (
          <li>
            <a href={url(s.href)} class="strength">
              <span class="strength__top" aria-hidden="true">
                <span class="strength__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="strength__arrow">↗</span>
              </span>
              <span class="strength__title">{s.title}</span>
              <span class="strength__text">{s.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ FEATURED WORK ============ -->
  <section id="work" class="section" aria-labelledby="work-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{home.work.eyebrow}</p>
        <div>
          <h2 id="work-title" set:html={emph(home.work.heading)} />
          <p class="lead">{home.work.lead}</p>
        </div>
      </div>
      <div class="work__list">
        {featuredStudies.map((s, i) => <CaseCard study={s} index={i} featured={i === 0} />)}
      </div>
    </div>
  </section>

  <!-- ============ RESEARCH & DESIGN EXPERIENCE (most relevant roles) ============ -->
  <section id="research" class="section section--rule" aria-labelledby="research-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow eyebrow--teal">{home.research.eyebrow}</p>
        <div>
          <h2 id="research-title" set:html={emph(home.research.heading)} />
          <p class="lead">{home.research.lead}</p>
        </div>
      </div>
      <ul class="roles">
        {researchRoles.map((e) => (
          <li class="role">
            <div class="role__meta">
              <p class="role__dates"><Txt text={e.dates} /></p>
              <h3>{e.title}</h3>
              <p class="role__org">{e.org}</p>
              {e.caseStudy && <a class="role__link" href={url(`/work/${e.caseStudy}`)}>Read the case study <span aria-hidden="true">↗</span></a>}
            </div>
            <div class="role__body">
              {e.focus && <ul class="role__focus" aria-label="Focus">{e.focus.map((f, i) => <li class:list={{ 'is-key': i === 0 }}>{f}</li>)}</ul>}
              <ul class="role__bullets">{e.bullets.map((b) => <li><Txt text={b} /></li>)}</ul>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ OTHER EXPERIENCE (less relevant to research / APM roles) ============ -->
  <section id="experience" class="section section--rule" aria-labelledby="exp-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{home.experience.eyebrow}</p>
        <h2 id="exp-title" set:html={emph(home.experience.heading)} />
      </div>

      <h3 class="sub-label eyebrow eyebrow--muted">{home.experience.projectsLabel}</h3>
      <div class="more-grid">
        {moreStudies.map((s) => <CaseCard study={s} index={0} compact />)}
      </div>

      <h3 class="sub-label eyebrow eyebrow--muted">{home.experience.rolesLabel}</h3>
      <ul class="exp">
        {otherRoles.map((e) => (
          <li class="exp__item">
            <p class="exp__dates"><Txt text={e.dates} /></p>
            <h4>{e.title}</h4>
            <p class="exp__org">{e.org}</p>
            <ul class="exp__bullets">{e.bullets.map((b) => <li><Txt text={b} /></li>)}</ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ SKILLS ============ -->
  <section id="skills" class="section skills-band" aria-labelledby="skills-title">
    <div class="container skills-grid">
      <div>
        <p class="eyebrow eyebrow--teal">{home.skills.eyebrow}</p>
        <h2 id="skills-title" set:html={emph(home.skills.heading)} />
        <p class="lead">{home.skills.lead}</p>
      </div>
      <div>
        <dl class="skills">
          {skills.map((g) => (
            <div class="skills__row">
              <dt>{g.group}</dt>
              <dd>
                <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
              </dd>
            </div>
          ))}
        </dl>
        <div class="certs">
          <h3 class="eyebrow eyebrow--muted">Certifications</h3>
          <ul>
            {certifications.map((c) => (
              <li class="cert">
                <div class="cert__img"><Media {...c.image} ratio="4 / 3" fit="contain" /></div>
                <div class="cert__text">
                  <span class="cert__name">{c.name}</span>
                  <span class="cert__meta">{c.issuer} · {c.date}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <p class="coursework"><span class="eyebrow eyebrow--muted">Relevant coursework</span>{coursework.join(' · ')}</p>
      </div>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section id="contact" class="contact" aria-labelledby="contact-title">
    <div class="container contact__grid">
      <div>
        <p class="eyebrow contact__eyebrow">Contact / next conversation</p>
        <h2 id="contact-title" set:html={emph(contact.heading)} />
        <p class="contact__line">{contact.line}</p>
      </div>
      <div class="contact__actions">
        <a class="contact__email" href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true">↗</span></a>
        {isTodo(site.linkedin)
          ? <span class="todo">{site.linkedin}</span>
          : <a class="contact__link" href={site.linkedin} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>}
        <a class="contact__resume" href={url(site.resume)} target="_blank" rel="noopener">Get the resume<span class="visually-hidden"> (PDF, opens in a new tab)</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Intro ---------- */
  .intro { position: relative; overflow: hidden; padding-top: clamp(2.5rem, 5vw, 3.75rem); border-bottom: 1px solid rgba(29, 43, 52, 0.12); }
  .intro__glow {
    position: absolute; right: -5rem; top: 3rem;
    width: 22rem; height: 22rem; border-radius: 50%;
    background: rgba(235, 199, 102, 0.42); filter: blur(64px);
    pointer-events: none;
  }
  .intro__grid { position: relative; display: grid; gap: 3.5rem; align-items: start; }
  @media (min-width: 1000px) {
    .intro__grid { grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.75fr); gap: 5rem; }
  }
  .intro h1 {
    font-size: clamp(3rem, 5.4vw, 5rem);
    line-height: 0.92; letter-spacing: -0.035em;
    margin-bottom: 1.4rem; max-width: 16ch;
  }
  .intro__sub {
    list-style: none; padding: 0; margin: 0 0 1.6rem;
    display: flex; flex-direction: column; gap: 0.1rem;
    font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.04em; color: var(--muted);
  }
  @media (min-width: 640px) {
    .intro__sub { flex-direction: row; flex-wrap: wrap; }
    .intro__sub li:not(:last-child)::after { content: '/'; margin-inline: 0.7rem; color: var(--coral); }
  }
  .intro__about { max-width: 40rem; }
  .intro__about p { color: var(--muted); }
  .intro__about p:first-child { font-size: 1.2rem; line-height: 1.65; color: var(--ink); }
  .intro__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }

  /* Portrait: teal offset block + specimen-style caption */
  .portrait { margin: 0; width: 100%; max-width: 360px; }
  @media (min-width: 1000px) { .portrait { justify-self: end; margin-top: 0.5rem; } }
  .portrait__frame { position: relative; margin: 0 14px 14px 0; }
  .portrait__frame::before {
    content: ''; position: absolute; inset: 14px -14px -14px 14px;
    background: var(--teal); border-radius: var(--r);
  }
  .portrait__frame > :global(.media) { position: relative; }
  .portrait figcaption {
    margin-top: 1.1rem;
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.06em; color: var(--muted);
  }
  .facts { list-style: none; margin: 1rem 0 0; padding: 0; font-size: 0.9rem; }
  .facts li { display: flex; gap: 0.75rem; padding: 0.55rem 0; border-top: 1px solid rgba(29, 43, 52, 0.14); }
  .facts li:last-child { border-bottom: 1px solid rgba(29, 43, 52, 0.14); }
  .facts__n { font-family: var(--font-mono); font-size: 0.7rem; color: var(--coral-deep); padding-top: 0.2rem; }

  /* Phones + tablets: photo stays at the top as a compact ID card (photo + facts side by side) */
  @media (max-width: 999px) {
    .intro__grid { gap: 2rem; }
    .portrait {
      order: -1; max-width: 34rem;
      display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); column-gap: 1.25rem; align-items: start;
    }
    .portrait__frame { margin: 0 8px 8px 0; }
    .portrait__frame::before { inset: 8px -8px -8px 8px; }
    .portrait figcaption { grid-column: 1 / -1; margin-top: 0.9rem; }
    .facts { grid-column: 2; grid-row: 1; margin: 0; font-size: 0.82rem; line-height: 1.4; }
    .facts li { padding: 0.45rem 0; gap: 0.5rem; }
    .facts li:first-child { border-top: 0; padding-top: 0; }
    .facts li:last-child { border-bottom: 0; }
  }

  /* What I bring */
  .strengths { position: relative; padding-top: clamp(3.5rem, 7vw, 5rem); padding-bottom: clamp(3rem, 6vw, 4rem); }
  .strengths .eyebrow { margin-bottom: 1rem; }
  .strengths__list { list-style: none; margin: 0; padding: 0; display: grid; }
  @media (min-width: 700px) { .strengths__list { grid-template-columns: repeat(2, 1fr); column-gap: 2rem; } }
  @media (min-width: 1100px) { .strengths__list { grid-template-columns: repeat(4, 1fr); } }
  .strength {
    display: flex; flex-direction: column; gap: 0.3rem;
    height: 100%; padding: 1.1rem 0 1.25rem;
    border-top: 1px solid var(--ink);
    color: var(--ink); text-decoration: none;
  }
  .strength:hover { color: var(--ink); }
  .strength__top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.4rem; }
  .strength__num { font-family: var(--font-display); font-size: 2rem; line-height: 1; color: var(--coral); }
  .strength__title { font-weight: 600; }
  .strength__arrow { display: inline-block; color: var(--coral-deep); transition: transform 0.3s var(--ease); }
  .strength:hover .strength__arrow { transform: translate(3px, -3px); }
  .strength:hover .strength__title { text-decoration: underline; text-decoration-color: var(--coral); text-underline-offset: 0.25em; }
  .strength__text { font-size: 0.9rem; color: var(--muted); line-height: 1.5; }

  /* ---------- Work ---------- */
  .work__list { display: grid; gap: 1.5rem; }

  /* ---------- Research & design roles ---------- */
  .section--rule { border-top: 1px solid rgba(29, 43, 52, 0.12); }
  .roles { list-style: none; margin: 0; padding: 0; }
  .role {
    display: grid; gap: 1rem 3rem;
    padding: 2rem 0 2.25rem; border-top: 1px solid rgba(29, 43, 52, 0.22);
  }
  .role:last-child { border-bottom: 1px solid rgba(29, 43, 52, 0.22); }
  @media (min-width: 900px) { .role { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr); } }
  .role__dates { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.04em; color: var(--muted); margin-bottom: 0.6rem; }
  .role__meta h3 { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.7rem, 2.6vw, 2.1rem); line-height: 1.05; letter-spacing: -0.01em; margin-bottom: 0.35rem; }
  .role__org { color: var(--teal); font-weight: 500; margin-bottom: 0.9rem; }
  .role__link {
    display: inline-flex; align-items: center; gap: 0.3rem; min-height: 44px;
    font-size: 0.9rem; font-weight: 600; text-decoration: underline;
    text-decoration-color: var(--coral); text-decoration-thickness: 2px; text-underline-offset: 0.45em;
  }
  .role__focus { list-style: none; margin: 0 0 1rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .role__focus li {
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 0.3rem 0.65rem; border-radius: 999px; border: 1px solid rgba(29, 43, 52, 0.18); color: var(--muted);
  }
  .role__focus li.is-key { background: var(--ochre); border-color: var(--ochre); color: var(--ink); }
  .role__bullets { margin: 0; padding-left: 1.05rem; color: var(--ink-2); line-height: 1.7; }
  .role__bullets li { margin-bottom: 0.55rem; padding-left: 0.25rem; }
  .role__bullets li::marker { color: var(--coral); }
  .role__text { color: var(--ink-2); }
  .role__img { max-width: 440px; }

  /* ---------- Other experience ---------- */
  .sub-label { margin: 0 0 1.25rem; }
  .more-grid { display: grid; gap: 1.25rem; margin-bottom: 3.5rem; }
  @media (min-width: 800px) { .more-grid { grid-template-columns: repeat(2, 1fr); } }
  .exp { list-style: none; margin: 0; padding: 0; display: grid; gap: 0 3rem; }
  @media (min-width: 800px) { .exp { grid-template-columns: repeat(2, 1fr); } }
  .exp__item { padding: 1.5rem 0 2rem; border-top: 1px solid rgba(29, 43, 52, 0.18); }
  .exp__dates { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.04em; color: var(--muted); margin-bottom: 0.6rem; }
  .exp__item h4 { margin-bottom: 0.1rem; }
  .exp__org { color: var(--teal); font-weight: 500; font-size: 0.95rem; margin-bottom: 0.9rem; }
  .exp__bullets { margin: 0; padding-left: 1.05rem; color: var(--muted); font-size: 0.95rem; line-height: 1.65; }
  .exp__bullets li { margin-bottom: 0.45rem; padding-left: 0.2rem; }
  .exp__bullets li::marker { color: var(--coral); }

  /* ---------- Skills ---------- */
  .skills-band { background: rgba(60, 114, 110, 0.08); border-block: 1px solid rgba(29, 43, 52, 0.12); }
  .skills-grid { display: grid; gap: 2.5rem 4rem; }
  @media (min-width: 1000px) { .skills-grid { grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); } }
  .skills-grid .lead { max-width: 22rem; }
  .skills { margin: 0; }
  .skills__row { display: grid; gap: 0.35rem 2rem; padding: 1.25rem 0; border-top: 1px solid rgba(29, 43, 52, 0.18); }
  @media (min-width: 640px) { .skills__row { grid-template-columns: 11rem 1fr; } }
  .skills__row dt { font-weight: 600; }
  .skills__row dd { margin: 0; }
  .skills__row ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; color: var(--muted); }
  .skills__row li:not(:last-child)::after { content: '·'; margin-inline: 0.55rem; color: var(--teal); }
  .certs { margin-top: 2.5rem; }
  .certs .eyebrow { margin-bottom: 0.6rem; }
  .certs ul { list-style: none; margin: 0; padding: 0; }
  .cert { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 1.1rem; align-items: center; padding: 0.9rem 0; border-top: 1px solid rgba(29, 43, 52, 0.18); }
  .cert__text { display: flex; flex-direction: column; gap: 0.2rem; }
  .cert__img :global(.media--contain img) { padding: 0.25rem; }
  .cert__img :global(.media__zoom-hint) { display: none; }
  .cert:last-child { border-bottom: 1px solid rgba(29, 43, 52, 0.18); }
  .cert__name { font-weight: 600; }
  .cert__meta { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.04em; color: var(--muted); }
  .coursework { margin: 2.5rem 0 0; color: var(--muted); font-size: 0.95rem; }
  .coursework .eyebrow { display: block; margin-bottom: 0.6rem; }

  /* ---------- Contact ---------- */
  .contact { background: var(--ink); color: var(--bg); padding-block: clamp(5rem, 11vw, 8rem) clamp(4rem, 8vw, 6rem); }
  .contact__grid { display: grid; gap: 3rem; align-items: end; }
  @media (min-width: 1000px) { .contact__grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); } }
  .contact__eyebrow { color: var(--ochre); }
  .contact h2 { font-size: clamp(3.5rem, 10vw, 7.5rem); line-height: 0.88; color: var(--bg); margin-bottom: 0.35em; }
  .contact h2 :global(em) { color: var(--ochre); }
  .contact__line { color: var(--paper-on-ink); font-size: 1.15rem; max-width: 30rem; margin: 0; }
  .contact__actions { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }
  @media (min-width: 1000px) { .contact__actions { align-items: flex-end; } }
  .contact__email {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px;
    font-size: clamp(1.1rem, 2.4vw, 1.3rem); font-weight: 600; color: var(--bg);
    text-decoration: underline; text-decoration-color: var(--coral); text-decoration-thickness: 2px; text-underline-offset: 0.4em;
    overflow-wrap: anywhere;
  }
  .contact__email:hover, .contact__link:hover { color: var(--ochre); }
  .contact__link { color: var(--paper-on-ink); min-height: 44px; display: inline-flex; align-items: center; text-decoration: none; }
  .contact__resume {
    margin-top: 0.75rem; display: inline-flex; align-items: center; min-height: 48px;
    padding: 0 1.25rem; border: 1px solid rgba(248, 246, 241, 0.35);
    color: var(--bg); text-decoration: none; font-size: 0.92rem;
    transition: background 0.2s, color 0.2s;
  }
  .contact__resume:hover { background: var(--bg); color: var(--ink); }
  .contact :focus-visible { box-shadow: none; }
</style>
